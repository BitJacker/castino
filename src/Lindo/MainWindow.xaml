<Window x:Class="Lindo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:Lindo"
        Title="Lindo" Width="1180" Height="760" MinWidth="940" MinHeight="600"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="14"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True"
        Icon="pack://application:,,,/Assets/lindo.ico">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <local:InverseBoolToVisibility x:Key="NotVis"/>
        <!-- ====== Riga di un'app ====== -->
        <DataTemplate x:Key="AppRow">
            <Border x:Name="card" CornerRadius="14" Background="{StaticResource Card}" Margin="0,0,0,8" Padding="14,12"
                    BorderThickness="1" BorderBrush="Transparent">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34"/>
                        <ColumnDefinition Width="44"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="190"/>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalAlignment="Center" Checked="OnAppCheckClick" Unchecked="OnAppCheckClick"
                              AutomationProperties.Name="{Binding Name, StringFormat='Seleziona {0}'}"
                              IsEnabled="{Binding CanUninstall}" ToolTip="Seleziona per disinstallare più app insieme"/>

                    <Grid Grid.Column="1" Width="40" Height="40" VerticalAlignment="Center">
                        <Border CornerRadius="11" Background="{Binding AvatarBrush}">
                            <TextBlock Text="{Binding Initials}" Foreground="White" FontWeight="Bold" FontSize="14"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border CornerRadius="11" Background="#1C2230"
                                Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}">
                            <Image Source="{Binding Icon}" Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                    </Grid>

                    <StackPanel Grid.Column="2" Margin="14,0,16,0" VerticalAlignment="Center">
                        <DockPanel LastChildFill="True">
                            <Border DockPanel.Dock="Right" CornerRadius="6" Background="{StaticResource WarningSoft}" Padding="6,1" Margin="8,0,0,0"
                                    VerticalAlignment="Center" Visibility="{Binding IsUnused, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Non usata" FontSize="11" Foreground="{StaticResource Warning}" FontWeight="SemiBold"/>
                            </Border>
                            <Border DockPanel.Dock="Right" CornerRadius="6" Background="#2222D3EE" Padding="6,1" Margin="8,0,0,0"
                                    VerticalAlignment="Center" Visibility="{Binding IsDriver, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Driver" FontSize="11" Foreground="#67E8F9" FontWeight="SemiBold"/>
                            </Border>
                            <Border DockPanel.Dock="Right" CornerRadius="6" Background="{StaticResource AccentSoft}" Padding="6,1" Margin="8,0,0,0"
                                    VerticalAlignment="Center" Visibility="{Binding IsStore, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Store" FontSize="11" Foreground="#A99BFF" FontWeight="SemiBold"/>
                            </Border>
                            <TextBlock Text="{Binding Name}" FontSize="14.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Name}"/>
                        </DockPanel>
                        <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource Subtle}" FontSize="12.5" Margin="0,3,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,24,0">
                        <TextBlock Text="{Binding SizeText}" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Right"/>
                        <Grid Height="5" Margin="0,7,0,0">
                            <Border CornerRadius="3" Background="#14FFFFFF"/>
                            <Border CornerRadius="3" Background="{StaticResource AccentHorizontal}" RenderTransformOrigin="0,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="{Binding SizeRatio}"/>
                                </Border.RenderTransform>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Column="4" VerticalAlignment="Center" ToolTip="{Binding ColumnTooltip}" Background="Transparent">
                        <TextBlock Text="{Binding ColumnLabel}" Foreground="{StaticResource Faint}" FontSize="11.5"/>
                        <TextBlock Text="{Binding ColumnText}" Foreground="{StaticResource Subtle}" FontSize="12.5" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <Border Grid.Column="5" CornerRadius="10" Background="#14FFFFFF" Padding="14,7" VerticalAlignment="Center"
                            Visibility="{Binding CanUninstall, Converter={StaticResource NotVis}}"
                            ToolTip="Driver indispensabile (video, rete, disco, audio…): Lindo non lo rimuove">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72E;" FontFamily="{StaticResource Icons}" FontSize="13" Foreground="{StaticResource Faint}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Protetto" Foreground="{StaticResource Faint}" FontSize="12.5" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                    <Button Grid.Column="5" Style="{StaticResource RowUninstallButton}" Click="OnUninstallClick" Tag="{Binding}"
                            AutomationProperties.Name="{Binding Name, StringFormat='Disinstalla {0}'}"
                            VerticalAlignment="Center" Visibility="{Binding CanUninstall, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74D;" FontFamily="{StaticResource Icons}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Disinstalla" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="card" Property="IsMouseOver" Value="True">
                    <Setter TargetName="card" Property="Background" Value="{StaticResource CardHover}"/>
                    <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource Border}"/>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ====== Riga di un residuo ====== -->
        <DataTemplate x:Key="LeftoverRow">
            <Border x:Name="card" CornerRadius="12" Background="{StaticResource Card}" Margin="0,0,0,6" Padding="12,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" AutomationProperties.Name="{Binding Path}"/>
                    <Border Grid.Column="1" Width="34" Height="34" CornerRadius="9" Background="#14FFFFFF" Margin="12,0,12,0">
                        <TextBlock Text="{Binding Glyph}" Style="{StaticResource Glyph}" FontSize="15" Foreground="{StaticResource Subtle}"/>
                    </Border>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Path}" FontSize="13" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Border Style="{StaticResource ConfidenceBadge}">
                                <TextBlock Text="{Binding ConfidenceText}" Style="{StaticResource ConfidenceText}"/>
                            </Border>
                            <TextBlock Text="{Binding KindText}" Foreground="{StaticResource Faint}" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock Text="·" Foreground="{StaticResource Faint}" FontSize="12" Margin="6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Reason}" Foreground="{StaticResource Subtle}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="12,0">
                        <TextBlock Text="{Binding SizeText}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                        <TextBlock Text="{Binding DateText}" Foreground="{StaticResource Faint}" FontSize="11.5" HorizontalAlignment="Right" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="4" Style="{StaticResource GhostButton}" Padding="10,6" Click="OnOpenLeftoverClick" Tag="{Binding}"
                            ToolTip="Mostra in Esplora file">
                        <TextBlock Text="&#xE838;" FontFamily="{StaticResource Icons}" FontSize="14"/>
                    </Button>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="card" Property="IsMouseOver" Value="True">
                    <Setter TargetName="card" Property="Background" Value="{StaticResource CardHover}"/>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ====== Spinner ====== -->
        <Style x:Key="Spinner" TargetType="Grid">
            <Setter Property="Width" Value="56"/>
            <Setter Property="Height" Value="56"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= SIDEBAR ================= -->
        <Border Background="{StaticResource Sidebar}" BorderBrush="#1B1F2A" BorderThickness="0,0,1,0">
            <Grid Margin="16,14,16,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="6,8,0,22">
                    <Image Source="pack://application:,,,/Assets/logo.png" Width="38" Height="38" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Lindo" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="Bold"/>
                        <TextBlock Text="Disinstalla senza residui" Foreground="{StaticResource Faint}" FontSize="11.5"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <TextBlock Text="MENU" Foreground="{StaticResource Faint}" FontSize="11" FontWeight="SemiBold" Margin="16,0,0,8"/>
                    <RadioButton x:Name="NavApps" Style="{StaticResource NavButton}" Tag="&#xE71D;" Content="Applicazioni" IsChecked="True" Checked="OnNavChanged"/>
                    <RadioButton x:Name="NavLeftovers" Style="{StaticResource NavButton}" Tag="&#xE8B7;" Content="Residui e verifica" Checked="OnNavChanged"/>
                    <RadioButton x:Name="NavClean" Style="{StaticResource NavButton}" Tag="&#xE945;" Content="Pulizia rapida" Checked="OnNavChanged"/>
                    <RadioButton x:Name="NavStartup" Style="{StaticResource NavButton}" Tag="&#xE7E8;" Content="Avvio e attività" Checked="OnNavChanged"/>
                    <RadioButton x:Name="NavOptimize" Style="{StaticResource NavButton}" Tag="&#xE9D9;" Content="Ottimizza" Checked="OnNavChanged"/>
                    <RadioButton x:Name="NavCrashes" Style="{StaticResource NavButton}" Tag="&#xE7BA;" Content="Errori e crash" Checked="OnNavChanged"/>
                </StackPanel>

                <!-- Dischi -->
                <StackPanel Grid.Row="3">
                    <TextBlock Text="DISCHI" Foreground="{StaticResource Faint}" FontSize="11" FontWeight="SemiBold" Margin="16,0,0,8"/>
                    <ScrollViewer MaxHeight="250" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="DrivesList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="card" CornerRadius="12" Padding="12,9" Margin="0,0,0,6" Background="#171B25"
                                            BorderBrush="{StaticResource Border}" BorderThickness="1" Cursor="Hand"
                                            MouseLeftButtonUp="OnDriveClick" Tag="{Binding}" ToolTip="Mostra solo le app di questo disco">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="30" Height="30" CornerRadius="8" Background="{StaticResource AccentSoft}" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Letter}" FontWeight="Bold" FontSize="12" Foreground="#C9BEFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                <Grid>
                                                    <TextBlock Text="{Binding FreeText}" FontWeight="SemiBold" FontSize="13"/>
                                                    <TextBlock Text="{Binding Label}" Foreground="{StaticResource Faint}" FontSize="11" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" MaxWidth="80"/>
                                                </Grid>
                                                <Grid Height="4" Margin="0,5,0,4">
                                                    <Border CornerRadius="2" Background="#1AFFFFFF"/>
                                                    <Border x:Name="bar" CornerRadius="2" Background="{StaticResource AccentHorizontal}" RenderTransformOrigin="0,0.5">
                                                        <Border.RenderTransform><ScaleTransform ScaleX="{Binding UsedRatio}"/></Border.RenderTransform>
                                                    </Border>
                                                </Grid>
                                                <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Subtle}" FontSize="11"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsLow}" Value="True">
                                            <Setter TargetName="bar" Property="Background" Value="{StaticResource DangerGradient}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource AccentSolid}"/>
                                        </DataTrigger>
                                        <Trigger SourceName="card" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="card" Property="Background" Value="#1D2230"/>
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= AREA PRINCIPALE ================= -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Barra del titolo -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="OnMinimize" ToolTip="Riduci a icona"/>
                <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="OnMaximize" ToolTip="Ingrandisci"/>
                <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" Click="OnClose" ToolTip="Chiudi"/>
            </StackPanel>

            <!-- ===== Pagina: Applicazioni ===== -->
            <Grid x:Name="PageApps" Grid.Row="1" Margin="36,0,30,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,18">
                    <StackPanel>
                        <TextBlock Text="Applicazioni installate" Style="{StaticResource H1}"/>
                        <TextBlock x:Name="AppsSummary" Text="Analisi in corso…" Style="{StaticResource SubtleText}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource BaseButton}" Click="OnRefreshClick">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" FontFamily="{StaticResource Icons}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Aggiorna"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Riepilogo spazio -->
                <Grid Grid.Row="1" Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Border CornerRadius="16" Padding="18,14" Background="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="App installate" Foreground="{StaticResource Subtle}" FontSize="12.5"/>
                            <TextBlock x:Name="StatCount" Text="—" FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="Bold" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" CornerRadius="16" Padding="18,14" Background="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Spazio occupato dalle app" Foreground="{StaticResource Subtle}" FontSize="12.5"/>
                            <TextBlock x:Name="StatSize" Text="—" FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="Bold" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="4" CornerRadius="16" Padding="18,14" Background="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="L'app più pesante" Foreground="{StaticResource Subtle}" FontSize="12.5"/>
                            <TextBlock x:Name="StatBiggest" Text="—" FontFamily="{StaticResource DisplayFont}" FontSize="18" FontWeight="Bold"
                                       Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="StatBiggestSize" Text="" Foreground="{StaticResource Subtle}" FontSize="12.5"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Barra strumenti -->
                <StackPanel Grid.Row="2" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="200"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SearchBox" Style="{StaticResource SearchBox}" Tag="Cerca un'app, un editore o un driver…" TextChanged="OnSearchChanged"/>
                        <ComboBox x:Name="DriveBox" Grid.Column="1" Style="{StaticResource DarkCombo}" Margin="12,0,0,0" SelectionChanged="OnDriveFilterChanged"/>
                        <ComboBox x:Name="SortBox" Grid.Column="2" Style="{StaticResource DarkCombo}" Margin="12,0,0,0" SelectedIndex="0" SelectionChanged="OnSortChanged">
                            <ComboBoxItem Content="Più pesanti prima"/>
                            <ComboBoxItem Content="Nome (A-Z)"/>
                            <ComboBoxItem Content="Installate di recente"/>
                            <ComboBoxItem Content="Meno usate prima"/>
                        </ComboBox>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <RadioButton x:Name="FilterAll" Style="{StaticResource Chip}" Content="Tutte" IsChecked="True" GroupName="flt" Checked="OnFilterChanged"/>
                        <RadioButton x:Name="FilterDesktop" Style="{StaticResource Chip}" Content="Programmi" GroupName="flt" Checked="OnFilterChanged"/>
                        <RadioButton x:Name="FilterStore" Style="{StaticResource Chip}" Content="Store" GroupName="flt" Checked="OnFilterChanged"/>
                        <RadioButton x:Name="FilterDrivers" Style="{StaticResource Chip}" Content="Driver" GroupName="flt" Checked="OnFilterChanged"/>
                        <RadioButton x:Name="FilterUnused" Style="{StaticResource Chip}" GroupName="flt" Checked="OnFilterChanged">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE823;" FontFamily="{StaticResource Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock x:Name="FilterUnusedText" Text="Non usate"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </StackPanel>

                <Grid Grid.Row="3">
                    <ListBox x:Name="AppsList" Style="{StaticResource PlainList}" ItemTemplate="{StaticResource AppRow}" Margin="0,0,-10,0" Padding="0,0,10,12"/>

                    <!-- Selezione multipla -->
                    <Border x:Name="AppsSelectionBar" VerticalAlignment="Bottom" CornerRadius="16" Background="#232A3A" BorderBrush="{StaticResource AccentSolid}"
                            BorderThickness="1" Padding="18,10" Margin="0,0,0,16" Visibility="Collapsed">
                        <Border.Effect><DropShadowEffect BlurRadius="30" ShadowDepth="6" Opacity="0.5"/></Border.Effect>
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE73A;" FontFamily="{StaticResource Icons}" Foreground="#A99BFF" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock x:Name="AppsSelectionText" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource GhostButton}" Content="Deseleziona" Click="OnClearAppSelection" Margin="0,0,8,0"/>
                                <Button x:Name="UninstallSelectedButton" Style="{StaticResource DangerButton}" Click="OnUninstallSelected" AutomationProperties.Name="Disinstalla selezionate">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE74D;" FontFamily="{StaticResource Icons}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="Disinstalla selezionate"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Stato: caricamento -->
                    <StackPanel x:Name="AppsLoading" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid x:Name="LoadingSpinner" Width="52" Height="52" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform><RotateTransform/></Grid.RenderTransform>
                            <Ellipse Stroke="#22FFFFFF" StrokeThickness="5"/>
                            <Path Stroke="{StaticResource Accent}" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M 26,2.5 A 23.5,23.5 0 0 1 49.5,26"/>
                        </Grid>
                        <TextBlock Text="Sto cercando le app installate…" Foreground="{StaticResource Subtle}" Margin="0,16,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Stato: nessun risultato -->
                    <StackPanel x:Name="AppsEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock Text="&#xE721;" Style="{StaticResource Glyph}" FontSize="34" Foreground="{StaticResource Faint}"/>
                        <TextBlock Text="Nessuna app corrisponde alla ricerca" Foreground="{StaticResource Subtle}" Margin="0,14,0,0"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- ===== Pagina: Residui ===== -->
            <Grid x:Name="PageLeftovers" Grid.Row="1" Margin="36,0,30,0" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,18">
                    <StackPanel Margin="0,0,200,0">
                        <TextBlock Text="Residui e verifica" Style="{StaticResource H1}"/>
                        <TextBlock Text="Cerca le cartelle rimaste da programmi già disinstallati e le voci “fantasma” che restano nell'elenco delle app."
                                   Style="{StaticResource SubtleText}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Button x:Name="ScanOrphansButton" AutomationProperties.Name="Analizza il sistema" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource PrimaryButton}" Click="OnScanOrphansClick">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE721;" FontFamily="{StaticResource Icons}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="ScanOrphansText" Text="Analizza il sistema"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <Border x:Name="OrphanWarning" Grid.Row="1" CornerRadius="12" Padding="14,10" Background="{StaticResource WarningSoft}" Margin="0,0,0,14" Visibility="Collapsed">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" Style="{StaticResource Glyph}" Foreground="{StaticResource Warning}" Margin="0,0,10,0"/>
                        <TextBlock TextWrapping="Wrap" Foreground="#F5D98B" FontSize="12.5"
                                   Text="«Sicuri da eliminare»: nessun programma installato, in esecuzione, nel PATH, nei servizi, all'avvio o nei collegamenti li usa, e non vengono toccati da almeno 3 mesi. «Seleziona tutti i sicuri» prende solo quelli. Gli elementi «Da controllare» vanno guardati uno per uno."/>
                    </DockPanel>
                </Border>

                <Grid Grid.Row="2">
                    <ListBox x:Name="OrphansList" Style="{StaticResource PlainList}" ItemTemplate="{StaticResource LeftoverRow}" Margin="0,0,-10,0" Padding="0,0,10,12"
                             VirtualizingPanel.IsVirtualizingWhenGrouping="True">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="4,10,0,10">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15"/>
                                            <TextBlock Text="{Binding ItemCount, StringFormat=' · {0}'}" Foreground="{StaticResource Subtle}" FontSize="15"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                    </ListBox>

                    <Border x:Name="OrphansIntro" CornerRadius="20" Background="{StaticResource Card}" Padding="40" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560">
                        <StackPanel>
                            <Border Width="72" Height="72" CornerRadius="22" Background="{StaticResource Accent}" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE8B7;" Style="{StaticResource Glyph}" FontSize="30" Foreground="White"/>
                            </Border>
                            <TextBlock Text="Hai già disinstallato qualcosa?" Style="{StaticResource H2}" HorizontalAlignment="Center" Margin="0,22,0,8"/>
                            <TextBlock TextAlignment="Center" Style="{StaticResource SubtleText}"
                                       Text="Lindo confronta le cartelle di Programmi, ProgramData e AppData con le app installate e ti mostra quello che è rimasto indietro, con quanto spazio occupa."/>
                        </StackPanel>
                    </Border>

                    <StackPanel x:Name="OrphansLoading" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                        <Grid x:Name="OrphansSpinner" Width="52" Height="52" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform><RotateTransform/></Grid.RenderTransform>
                            <Ellipse Stroke="#22FFFFFF" StrokeThickness="5"/>
                            <Path Stroke="{StaticResource Accent}" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M 26,2.5 A 23.5,23.5 0 0 1 49.5,26"/>
                        </Grid>
                        <TextBlock x:Name="OrphansLoadingText" Text="Analisi delle cartelle…" Foreground="{StaticResource Subtle}" Margin="0,16,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <Border x:Name="OrphansClean" CornerRadius="20" Background="{StaticResource Card}" Padding="40" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                        <StackPanel>
                            <Border Width="72" Height="72" CornerRadius="36" Background="{StaticResource SuccessSoft}" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE73E;" Style="{StaticResource Glyph}" FontSize="30" Foreground="{StaticResource Success}"/>
                            </Border>
                            <TextBlock Text="Tutto pulito!" Style="{StaticResource H2}" HorizontalAlignment="Center" Margin="0,20,0,6"/>
                            <TextBlock Text="Non ho trovato residui di programmi disinstallati." Style="{StaticResource SubtleText}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border x:Name="OrphansActionBar" Grid.Row="3" CornerRadius="16" Background="#1A1F2B" BorderBrush="{StaticResource Border}" BorderThickness="1"
                        Padding="18,12" Margin="0,4,0,22" Visibility="Collapsed">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox x:Name="OrphansSelectAll" Content="Seleziona tutti i sicuri" Checked="OnOrphansSelectAll" Unchecked="OnOrphansSelectAll" Foreground="{StaticResource Subtle}"/>
                            <TextBlock x:Name="OrphansSelection" Text="" Foreground="{StaticResource Subtle}" Margin="24,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button x:Name="DeleteOrphansButton" AutomationProperties.Name="Elimina residui selezionati" HorizontalAlignment="Right" Style="{StaticResource DangerButton}" Click="OnDeleteOrphansClick">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74D;" FontFamily="{StaticResource Icons}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Elimina selezionati"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </Grid>

            <!-- ===== Pagina: Pulizia rapida ===== -->
            <Grid x:Name="PageClean" Grid.Row="1" Margin="36,0,30,0" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,18">
                    <TextBlock Text="Pulizia rapida" Style="{StaticResource H1}"/>
                    <TextBlock Text="File temporanei e cache che Windows e le app ricreano da soli: eliminarli è sicuro e libera spazio subito."
                               Style="{StaticResource SubtleText}" Margin="0,4,0,0"/>
                </StackPanel>

                <Border Grid.Row="1" CornerRadius="20" Padding="26,22" Margin="0,0,0,18">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#2A7C5CFF" Offset="0"/>
                            <GradientStop Color="#1A22D3EE" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Spazio recuperabile" Foreground="{StaticResource Subtle}"/>
                            <TextBlock x:Name="CleanTotal" Text="Calcolo…" FontFamily="{StaticResource DisplayFont}" FontSize="38" FontWeight="Bold" Margin="0,2,0,0"/>
                            <TextBlock x:Name="CleanStatus" Text="Seleziona cosa pulire e premi “Pulisci ora”." Foreground="{StaticResource Subtle}" FontSize="12.5"/>
                        </StackPanel>
                        <Button x:Name="CleanButton" AutomationProperties.Name="Pulisci ora" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource PrimaryButton}"
                                Padding="26,13" FontSize="15" Click="OnQuickCleanClick">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE945;" FontFamily="{StaticResource Icons}" FontSize="15" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="Pulisci ora"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,-10,0" Padding="0,0,10,0">
                    <ItemsControl x:Name="CleanList" Margin="0,0,0,20">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="card" CornerRadius="16" Background="{StaticResource Card}" Margin="0,0,12,12" Padding="16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="42" Height="42" CornerRadius="12" Background="{StaticResource AccentSoft}" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding Glyph}" Style="{StaticResource Glyph}" FontSize="18" Foreground="#A99BFF"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="14,0,10,0">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource SubtleText}" FontSize="12.5" Margin="0,3,0,0"/>
                                            <TextBlock Text="{Binding SizeText}" FontWeight="SemiBold" Margin="0,8,0,0" Foreground="#C9BEFF"/>
                                        </StackPanel>
                                        <CheckBox Grid.Column="2" IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Top" Checked="OnCleanSelectionChanged" Unchecked="OnCleanSelectionChanged"/>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <Trigger SourceName="card" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="card" Property="Background" Value="{StaticResource CardHover}"/>
                                    </Trigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- ===== Pagina: Avvio e attività ===== -->
            <Grid x:Name="PageStartup" Grid.Row="1" Margin="36,0,30,0" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,16">
                    <StackPanel Margin="0,0,180,0">
                        <TextBlock Text="Avvio e attività" Style="{StaticResource H1}"/>
                        <TextBlock x:Name="StartupSummary" Text="Le app che partono con Windows e quanto usi (e quanto consumano) i tuoi programmi."
                                   Style="{StaticResource SubtleText}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource BaseButton}" Click="OnStartupRefresh">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" FontFamily="{StaticResource Icons}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Aggiorna"/>
                        </StackPanel>
                    </Button>
                </Grid>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,14">
                    <RadioButton x:Name="TabStartup" Style="{StaticResource Chip}" Content="App all'avvio" IsChecked="True" GroupName="stab" Checked="OnStartupTab"/>
                    <RadioButton x:Name="TabUsage" Style="{StaticResource Chip}" Content="Consumo e utilizzo" GroupName="stab" Checked="OnStartupTab"/>
                </StackPanel>

                <!-- App all'avvio -->
                <Grid x:Name="StartupPanel" Grid.Row="2">
                    <ListBox x:Name="StartupList" Style="{StaticResource PlainList}" Margin="0,0,-10,0" Padding="0,0,10,12">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="card" CornerRadius="14" Background="{StaticResource Card}" Margin="0,0,0,8" Padding="14,11">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="38" Height="38">
                                            <Border CornerRadius="10" Background="{StaticResource AccentSoft}">
                                                <TextBlock Text="{Binding Initials}" FontWeight="Bold" Foreground="#C9BEFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <Border CornerRadius="10" Background="#1C2230" Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}">
                                                <Image Source="{Binding Icon}" Width="28" Height="28"/>
                                            </Border>
                                        </Grid>
                                        <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="420"/>
                                                <Border Style="{StaticResource Badge}" Background="{StaticResource WarningSoft}" Visibility="{Binding IsSuggested, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="Si può togliere" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Warning}"/>
                                                </Border>
                                                <Border Style="{StaticResource Badge}" Background="{StaticResource SuccessSoft}" Visibility="{Binding IsEssential, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="Consigliato tenerla" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Success}"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource Subtle}" FontSize="12.5" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Command}" Foreground="{StaticResource Faint}" FontSize="11.5" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Command}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,18,0">
                                            <TextBlock Text="{Binding StateText}" Foreground="{StaticResource Subtle}" FontSize="12.5" HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding UsageText}" Foreground="{StaticResource Faint}" FontSize="11.5" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <ToggleButton Grid.Column="3" Style="{StaticResource Switch}" IsChecked="{Binding Enabled, Mode=OneWay}" Tag="{Binding}"
                                                      AutomationProperties.Name="{Binding Name, StringFormat='Avvio {0}'}"
                                                      Click="OnStartupToggle" VerticalAlignment="Center" ToolTip="Avvia con Windows"/>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <Trigger SourceName="card" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="card" Property="Background" Value="{StaticResource CardHover}"/>
                                    </Trigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel x:Name="StartupLoading" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid x:Name="StartupSpinner" Width="52" Height="52" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform><RotateTransform/></Grid.RenderTransform>
                            <Ellipse Stroke="#22FFFFFF" StrokeThickness="5"/>
                            <Path Stroke="{StaticResource Accent}" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 26,2.5 A 23.5,23.5 0 0 1 49.5,26"/>
                        </Grid>
                        <TextBlock Text="Leggo le app all'avvio, i servizi e le attività pianificate…" Foreground="{StaticResource Subtle}" Margin="0,16,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- Consumo e utilizzo -->
                <Grid x:Name="UsagePanel" Grid.Row="2" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border CornerRadius="16" Padding="18,14" Margin="0,0,0,14">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#2A7C5CFF" Offset="0"/>
                                <GradientStop Color="#1A22D3EE" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Monitoraggio in background" FontWeight="SemiBold" FontSize="15"/>
                                <TextBlock x:Name="MonitorStatus" Style="{StaticResource SubtleText}" Margin="0,3,0,0"
                                           Text="Un piccolo processo (LindoMonitor) controlla ogni 30 secondi quali programmi sono aperti e quanto consumano. I dati restano sul tuo PC."/>
                            </StackPanel>
                            <ToggleButton x:Name="MonitorSwitch" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="OnMonitorToggle"/>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                        <RadioButton x:Name="UsageByCpu" Style="{StaticResource Chip}" Content="Più CPU" IsChecked="True" GroupName="usort" Checked="OnUsageSort"/>
                        <RadioButton x:Name="UsageByMemory" Style="{StaticResource Chip}" Content="Più memoria" GroupName="usort" Checked="OnUsageSort"/>
                        <RadioButton x:Name="UsageByTime" Style="{StaticResource Chip}" Content="Più usate" GroupName="usort" Checked="OnUsageSort"/>
                        <Button Style="{StaticResource GhostButton}" Margin="10,0,0,0" Click="OnShowUnused" Padding="12,6">
                            <TextBlock x:Name="UnusedLink" Text="Vedi le app che non usi →" Foreground="#A99BFF"/>
                        </Button>
                    </StackPanel>
                    <ListBox x:Name="UsageList" Grid.Row="2" Style="{StaticResource PlainList}" Margin="0,0,-10,0" Padding="0,0,10,12">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="12" Background="{StaticResource Card}" Margin="0,0,0,6" Padding="14,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="90"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="32" Height="32">
                                            <Border CornerRadius="9" Background="{StaticResource AccentSoft}">
                                                <TextBlock Text="{Binding Initials}" FontWeight="Bold" Foreground="#C9BEFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <Border CornerRadius="9" Background="#1C2230" Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}">
                                                <Image Source="{Binding Icon}" Width="22" Height="22"/>
                                            </Border>
                                        </Grid>
                                        <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <Grid Height="4" Margin="0,6,0,0" MaxWidth="260" HorizontalAlignment="Left" Width="260">
                                                <Border CornerRadius="2" Background="#14FFFFFF"/>
                                                <Border CornerRadius="2" Background="{StaticResource AccentHorizontal}" RenderTransformOrigin="0,0.5">
                                                    <Border.RenderTransform><ScaleTransform ScaleX="{Binding Ratio}"/></Border.RenderTransform>
                                                </Border>
                                            </Grid>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="Aperta per" Foreground="{StaticResource Faint}" FontSize="11"/>
                                            <TextBlock Text="{Binding TimeText}" FontSize="12.5"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                            <TextBlock Text="Tempo CPU" Foreground="{StaticResource Faint}" FontSize="11"/>
                                            <TextBlock Text="{Binding CpuText}" FontSize="12.5"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                            <TextBlock Text="Memoria media" Foreground="{StaticResource Faint}" FontSize="11"/>
                                            <TextBlock Text="{Binding MemoryText}" FontSize="12.5"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="5" VerticalAlignment="Center">
                                            <TextBlock Text="Ultima volta" Foreground="{StaticResource Faint}" FontSize="11"/>
                                            <TextBlock Text="{Binding LastText}" FontSize="12.5"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Border x:Name="UsageEmpty" Grid.Row="2" CornerRadius="18" Background="{StaticResource Card}" Padding="30" VerticalAlignment="Top" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource SubtleText}" TextAlignment="Center"
                                   Text="Non ci sono ancora dati: attiva il monitoraggio e usa il PC normalmente. Dopo qualche ora qui vedrai quali programmi usi di più e quanto consumano."/>
                    </Border>
                </Grid>
            </Grid>

            <!-- ===== Pagina: Ottimizza ===== -->
            <Grid x:Name="PageOptimize" Grid.Row="1" Margin="36,0,30,0" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,18">
                    <TextBlock Text="Ottimizza il PC" Style="{StaticResource H1}"/>
                    <TextBlock Text="Impostazioni che rendono Windows e i giochi più reattivi. Tutto quello che è segnato come annullabile si rimette com'era con «Ripristina»."
                               Style="{StaticResource SubtleText}" Margin="0,4,0,0"/>
                </StackPanel>
                <Border Grid.Row="1" CornerRadius="20" Padding="26,22" Margin="0,0,0,18">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#2A7C5CFF" Offset="0"/>
                            <GradientStop Color="#1A22D3EE" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Stato del PC" Foreground="{StaticResource Subtle}"/>
                            <TextBlock x:Name="OptimizeScore" Text="Analisi…" FontFamily="{StaticResource DisplayFont}" FontSize="32" FontWeight="Bold" Margin="0,2,0,0"/>
                            <TextBlock x:Name="OptimizeStatus" Text="" Foreground="{StaticResource Subtle}" FontSize="12.5"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="RestoreButton" Style="{StaticResource GhostButton}" Content="Ripristina tutto" Margin="0,0,10,0" Click="OnOptimizeRestore"/>
                            <Button x:Name="OptimizeButton" AutomationProperties.Name="Ottimizza ora" Style="{StaticResource PrimaryButton}" Padding="26,13" FontSize="15" Click="OnOptimizeClick">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE945;" FontFamily="{StaticResource Icons}" FontSize="15" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="Ottimizza ora"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
                <!-- Risorse in tempo reale: CPU, RAM, scheda video -->
                <UniformGrid x:Name="ResourcesPanel" Grid.Row="2" Columns="3" Margin="-5,0,-5,14">
                    <UniformGrid.Resources>
                        <DataTemplate x:Key="UsageRowTemplate">
                            <Grid Margin="0,3,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="12.5"/>
                                <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12.5" Foreground="{StaticResource Subtle}" Margin="10,0,0,0"/>
                            </Grid>
                        </DataTemplate>
                    </UniformGrid.Resources>
                    <Border CornerRadius="16" Background="{StaticResource Card}" Padding="18,14" Margin="5,0">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="&#xE9D9;" Style="{StaticResource Glyph}" Foreground="#A99BFF" Margin="0,0,8,0"/>
                                <TextBlock Text="Processore (CPU)" Foreground="{StaticResource Subtle}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock x:Name="CpuValue" Text="…" FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="Bold" Margin="0,6,0,4"/>
                            <ProgressBar x:Name="CpuBar" Height="5" Maximum="100" Background="#22FFFFFF" BorderThickness="0" Foreground="{StaticResource AccentHorizontal}"/>
                            <TextBlock Text="Usano di più adesso" FontSize="11.5" Foreground="{StaticResource Faint}" Margin="0,10,0,2"/>
                            <ItemsControl x:Name="CpuTop" ItemTemplate="{StaticResource UsageRowTemplate}"/>
                        </StackPanel>
                    </Border>
                    <Border CornerRadius="16" Background="{StaticResource Card}" Padding="18,14" Margin="5,0">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="&#xE950;" Style="{StaticResource Glyph}" Foreground="#A99BFF" Margin="0,0,8,0"/>
                                <TextBlock Text="Memoria (RAM)" Foreground="{StaticResource Subtle}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock x:Name="RamValue" Text="…" FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="Bold" Margin="0,6,0,4"/>
                            <ProgressBar x:Name="RamBar" Height="5" Maximum="100" Background="#22FFFFFF" BorderThickness="0" Foreground="{StaticResource AccentHorizontal}"/>
                            <TextBlock x:Name="RamDetail" Text="" FontSize="11.5" Foreground="{StaticResource Faint}" Margin="0,10,0,2"/>
                            <ItemsControl x:Name="RamTop" ItemTemplate="{StaticResource UsageRowTemplate}"/>
                        </StackPanel>
                    </Border>
                    <Border CornerRadius="16" Background="{StaticResource Card}" Padding="18,14" Margin="5,0">
                        <StackPanel>
                            <DockPanel>
                                <Button x:Name="RefreshResourcesButton" DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="10,4" FontSize="12"
                                        Content="Aggiorna" Click="OnRefreshResources" AutomationProperties.Name="Aggiorna risorse"/>
                                <TextBlock Text="&#xE7F4;" Style="{StaticResource Glyph}" Foreground="#A99BFF" Margin="0,0,8,0"/>
                                <TextBlock Text="Scheda video (GPU)" Foreground="{StaticResource Subtle}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock x:Name="GpuNames" Text="…" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,2"/>
                            <TextBlock x:Name="GpuScheduling" Text="" FontSize="12" Foreground="{StaticResource Subtle}" TextWrapping="Wrap"/>
                            <WrapPanel Margin="0,10,0,0">
                                <Button x:Name="GpuSettingsButton" Style="{StaticResource GhostButton}" Padding="12,6" FontSize="12" Margin="0,0,8,6"
                                        Content="Impostazioni grafica" Click="OnOpenGraphicsSettings" AutomationProperties.Name="Impostazioni grafica"/>
                                <Button x:Name="GpuGameButton" Style="{StaticResource PrimaryButton}" Padding="12,6" FontSize="12" Margin="0,0,0,6" Visibility="Collapsed"
                                        Content="Gioco sulla scheda dedicata…" Click="OnGameOnDedicatedGpu" AutomationProperties.Name="Gioco sulla scheda dedicata"/>
                            </WrapPanel>
                            <TextBlock x:Name="GpuGames" Text="" FontSize="11.5" Foreground="{StaticResource Faint}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>
                <ListBox x:Name="OptimizeList" Grid.Row="3" Style="{StaticResource PlainList}" Margin="0,0,-10,0" Padding="0,0,10,12"
                         VirtualizingPanel.IsVirtualizingWhenGrouping="True">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" Margin="4,8,0,10"/>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="card" CornerRadius="14" Background="{StaticResource Card}" Margin="0,0,0,8" Padding="16,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center"/>
                                    <Border Grid.Column="1" Width="38" Height="38" CornerRadius="11" Background="{StaticResource AccentSoft}" Margin="12,0">
                                        <TextBlock Text="{Binding Glyph}" Style="{StaticResource Glyph}" Foreground="#A99BFF"/>
                                    </Border>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource SubtleText}" FontSize="12.5" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <Border x:Name="state" Grid.Column="3" Style="{StaticResource Badge}" Background="{StaticResource WarningSoft}" Margin="14,0,0,0">
                                        <TextBlock x:Name="stateText" Text="{Binding StateText}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Warning}"/>
                                    </Border>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsApplied}" Value="True">
                                    <Setter TargetName="state" Property="Background" Value="{StaticResource SuccessSoft}"/>
                                    <Setter TargetName="stateText" Property="Foreground" Value="{StaticResource Success}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Reversible}" Value="False">
                                    <Setter TargetName="state" Property="Background" Value="#14FFFFFF"/>
                                    <Setter TargetName="stateText" Property="Foreground" Value="{StaticResource Subtle}"/>
                                </DataTrigger>
                                <Trigger SourceName="card" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="card" Property="Background" Value="{StaticResource CardHover}"/>
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <!-- ===== Pagina: Errori e crash ===== -->
            <Grid x:Name="PageCrashes" Grid.Row="1" Margin="36,0,30,0" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,18">
                    <StackPanel Margin="0,0,320,0">
                        <TextBlock Text="Errori e crash" Style="{StaticResource H1}"/>
                        <TextBlock Text="Programmi che si sono chiusi da soli, blocchi e schermate blu degli ultimi 30 giorni, spiegati in parole semplici."
                                   Style="{StaticResource SubtleText}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource BaseButton}" Click="OnCrashRefresh" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72C;" FontFamily="{StaticResource Icons}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Aggiorna"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource PrimaryButton}" Click="OnCrashSave">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74E;" FontFamily="{StaticResource Icons}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Salva rapporto"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="1" Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Border CornerRadius="16" Padding="18,14" Background="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="App chiuse da sole" Foreground="{StaticResource Subtle}" FontSize="12.5"/>
                            <TextBlock x:Name="CrashStatApps" Text="—" FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="Bold" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" CornerRadius="16" Padding="18,14" Background="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Blocchi" Foreground="{StaticResource Subtle}" FontSize="12.5"/>
                            <TextBlock x:Name="CrashStatHangs" Text="—" FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="Bold" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="4" CornerRadius="16" Padding="18,14" Background="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Schermate blu e spegnimenti" Foreground="{StaticResource Subtle}" FontSize="12.5"/>
                            <TextBlock x:Name="CrashStatSystem" Text="—" FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="Bold" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
                <Grid Grid.Row="2">
                    <ListBox x:Name="CrashList" Style="{StaticResource PlainList}" Margin="0,0,-10,0" Padding="0,0,10,12">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="14" Background="{StaticResource Card}" Margin="0,0,0,8" Padding="16,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="badge" Width="38" Height="38" CornerRadius="11" Background="{StaticResource WarningSoft}" VerticalAlignment="Top">
                                            <TextBlock x:Name="glyph" Text="{Binding Glyph}" Style="{StaticResource Glyph}" Foreground="{StaticResource Warning}"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                            <Grid>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,260,0"/>
                                                <TextBlock Text="{Binding When}" Foreground="{StaticResource Subtle}" FontSize="12" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <TextBlock Text="{Binding Explanation}" Style="{StaticResource SubtleText}" Margin="0,5,0,0"/>
                                            <Border CornerRadius="10" Background="#1B2030" Padding="12,8" Margin="0,8,0,0">
                                                <TextBlock TextWrapping="Wrap" FontSize="13">
                                                    <Run Text="Cosa fare: " FontWeight="SemiBold" Foreground="#A99BFF"/><Run Text="{Binding Advice, Mode=OneWay}"/>
                                                </TextBlock>
                                            </Border>
                                            <TextBlock Text="{Binding Details}" Foreground="{StaticResource Faint}" FontSize="11.5" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Details}" Visibility="{Binding HasDetails, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSystem}" Value="True">
                                        <Setter TargetName="badge" Property="Background" Value="{StaticResource DangerSoft}"/>
                                        <Setter TargetName="glyph" Property="Foreground" Value="{StaticResource Danger}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel x:Name="CrashLoading" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid x:Name="CrashSpinner" Width="52" Height="52" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform><RotateTransform/></Grid.RenderTransform>
                            <Ellipse Stroke="#22FFFFFF" StrokeThickness="5"/>
                            <Path Stroke="{StaticResource Accent}" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 26,2.5 A 23.5,23.5 0 0 1 49.5,26"/>
                        </Grid>
                        <TextBlock Text="Leggo il Registro eventi di Windows…" Foreground="{StaticResource Subtle}" Margin="0,16,0,0"/>
                    </StackPanel>
                    <Border x:Name="CrashEmpty" CornerRadius="20" Background="{StaticResource Card}" Padding="40" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                        <StackPanel>
                            <Border Width="72" Height="72" CornerRadius="36" Background="{StaticResource SuccessSoft}" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE73E;" Style="{StaticResource Glyph}" FontSize="30" Foreground="{StaticResource Success}"/>
                            </Border>
                            <TextBlock Text="Nessun crash negli ultimi 30 giorni" Style="{StaticResource H2}" HorizontalAlignment="Center" Margin="0,20,0,6"/>
                            <TextBlock Text="Il tuo PC non ha registrato chiusure improvvise o schermate blu." Style="{StaticResource SubtleText}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- ================= DIALOGO (overlay) ================= -->
        <Grid x:Name="Overlay" Grid.ColumnSpan="2" Visibility="Collapsed" Background="{StaticResource Scrim}">
            <Border x:Name="DialogCard" Width="620" MaxHeight="680" CornerRadius="22" Background="#161A24" BorderBrush="{StaticResource Border}" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Padding="30,28" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="60" ShadowDepth="10" Opacity="0.55" Color="Black"/>
                </Border.Effect>
                <Grid>
                    <!-- Conferma -->
                    <StackPanel x:Name="DlgConfirm">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Grid Width="56" Height="56">
                                <Border x:Name="DlgAvatar" CornerRadius="15">
                                    <TextBlock x:Name="DlgInitials" Foreground="White" FontWeight="Bold" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border x:Name="DlgIconHost" CornerRadius="15" Background="#1C2230" Visibility="Collapsed">
                                    <Image x:Name="DlgIcon" Width="40" Height="40"/>
                                </Border>
                            </Grid>
                            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="DlgAppName" Style="{StaticResource H2}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="DlgAppMeta" Style="{StaticResource SubtleText}" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Cosa succede adesso" FontWeight="SemiBold" Margin="0,24,0,10"/>
                        <StackPanel x:Name="DlgSteps">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Border Width="24" Height="24" CornerRadius="12" Background="{StaticResource AccentSoft}"><TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="Bold" Foreground="#A99BFF"/></Border>
                                <TextBlock x:Name="DlgStep1" Text="Avvio il programma di disinstallazione ufficiale dell'app." Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Subtle}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Border Width="24" Height="24" CornerRadius="12" Background="{StaticResource AccentSoft}"><TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="Bold" Foreground="#A99BFF"/></Border>
                                <TextBlock Text="Cerco cartelle, collegamenti e chiavi di registro rimasti." Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Subtle}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="24" Height="24" CornerRadius="12" Background="{StaticResource AccentSoft}"><TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="Bold" Foreground="#A99BFF"/></Border>
                                <TextBlock Text="Ti mostro i residui: scegli tu cosa eliminare." Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Subtle}"/>
                            </StackPanel>
                        </StackPanel>

                        <Border x:Name="DlgNoUninstaller" CornerRadius="12" Padding="14,10" Background="{StaticResource WarningSoft}" Margin="0,18,0,0" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7BA;" Style="{StaticResource Glyph}" Foreground="{StaticResource Warning}" Margin="0,0,10,0" VerticalAlignment="Top"/>
                                <TextBlock TextWrapping="Wrap" Foreground="#F5D98B" FontSize="12.5" MaxWidth="500"
                                           Text="Il programma di disinstallazione di questa app non esiste più (l'app è stata cancellata a metà). Lindo può fare una rimozione forzata: elimina direttamente i file rimasti e la voce dall'elenco."/>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,28,0,0">
                            <Button Style="{StaticResource GhostButton}" Content="Annulla" Click="OnDialogCancel" Margin="0,0,10,0"/>
                            <Button x:Name="DlgConfirmButton" AutomationProperties.Name="Conferma" Style="{StaticResource DangerButton}" Click="OnConfirmUninstall" Padding="22,10">
                                <TextBlock x:Name="DlgConfirmText" Text="Disinstalla"/>
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <!-- In corso -->
                    <StackPanel x:Name="DlgRunning" Visibility="Collapsed" Margin="0,10">
                        <Grid x:Name="DlgSpinner" Width="64" Height="64" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform><RotateTransform/></Grid.RenderTransform>
                            <Ellipse Stroke="#22FFFFFF" StrokeThickness="6"/>
                            <Path Stroke="{StaticResource Accent}" StrokeThickness="6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M 32,3 A 29,29 0 0 1 61,32"/>
                        </Grid>
                        <TextBlock x:Name="DlgRunningTitle" Text="Disinstallazione in corso" Style="{StaticResource H2}" HorizontalAlignment="Center" Margin="0,22,0,6"/>
                        <TextBlock x:Name="DlgRunningText" Text="" Style="{StaticResource SubtleText}" TextAlignment="Center" HorizontalAlignment="Center" MaxWidth="460"/>
                        <Button x:Name="DlgSkipWait" Style="{StaticResource BaseButton}" Content="Ho finito, cerca i residui" HorizontalAlignment="Center" Margin="0,24,0,0" Click="OnSkipWait"/>
                    </StackPanel>

                    <!-- Residui trovati -->
                    <Grid x:Name="DlgLeftovers" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="DlgLeftoversTitle" Text="Residui trovati" Style="{StaticResource H2}"/>
                            <TextBlock x:Name="DlgLeftoversText" Style="{StaticResource SubtleText}" Margin="0,4,0,14"/>
                            <Border x:Name="DlgDriverQuestion" CornerRadius="12" Padding="14,10" Background="#2222D3EE" Margin="0,0,0,12" Visibility="Collapsed">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" Text="&#xE772;" Style="{StaticResource Glyph}" Foreground="#67E8F9" Margin="0,0,12,0"/>
                                    <StackPanel>
                                        <TextBlock x:Name="DlgDriverText" TextWrapping="Wrap" FontSize="13"/>
                                        <CheckBox x:Name="DlgDriverCheck" Content="Sì, elimina anche i driver" Margin="0,8,0,0" Checked="OnDlgDriverCheck" Unchecked="OnDlgDriverCheck"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                        <ListBox x:Name="DlgLeftoversList" Grid.Row="1" Style="{StaticResource PlainList}" ItemTemplate="{StaticResource LeftoverRow}" MaxHeight="380" Margin="0,0,-8,0" Padding="0,0,8,0"/>
                        <Grid Grid.Row="2" Margin="0,18,0,0">
                            <CheckBox x:Name="DlgSelectAll" Content="Seleziona tutto" Foreground="{StaticResource Subtle}" Checked="OnDlgSelectAll" Unchecked="OnDlgSelectAll" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource GhostButton}" Content="Salta" Click="OnSkipLeftovers" Margin="0,0,10,0"/>
                                <Button x:Name="DlgDeleteButton" AutomationProperties.Name="Elimina selezionati" Style="{StaticResource DangerButton}" Click="OnDeleteLeftovers" Padding="22,10">
                                    <TextBlock x:Name="DlgDeleteText" Text="Elimina selezionati"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- Risultato / messaggio -->
                    <StackPanel x:Name="DlgResult" Visibility="Collapsed">
                        <Border x:Name="DlgResultBadge" Width="76" Height="76" CornerRadius="38" Background="{StaticResource SuccessSoft}" HorizontalAlignment="Center">
                            <TextBlock x:Name="DlgResultGlyph" Text="&#xE73E;" Style="{StaticResource Glyph}" FontSize="32" Foreground="{StaticResource Success}"/>
                        </Border>
                        <TextBlock x:Name="DlgResultTitle" Style="{StaticResource H2}" FontSize="22" HorizontalAlignment="Center" Margin="0,20,0,4" TextAlignment="Center" TextWrapping="Wrap"/>
                        <TextBlock x:Name="DlgResultSubtitle" Style="{StaticResource SubtleText}" HorizontalAlignment="Center" TextAlignment="Center"/>
                        <Border CornerRadius="14" Background="#1B2030" Padding="18,14" Margin="0,22,0,0" x:Name="DlgChecksHost">
                            <ItemsControl x:Name="DlgChecks">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource Icons}" FontSize="14" Foreground="{Binding Brush}" VerticalAlignment="Top" Margin="0,2,12,0"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" FontSize="13"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
                            <Button x:Name="DlgResultSecondary" Style="{StaticResource GhostButton}" Margin="0,0,10,0" Click="OnResultSecondary" Visibility="Collapsed"/>
                            <Button x:Name="DlgResultPrimary" Style="{StaticResource PrimaryButton}" Content="Fatto" Padding="34,10" Click="OnResultPrimary"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Notifica in basso -->
        <Border x:Name="Toast" Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,26"
                CornerRadius="14" Background="#222838" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="18,12"
                Opacity="0" IsHitTestVisible="False">
            <Border.Effect><DropShadowEffect BlurRadius="30" ShadowDepth="6" Opacity="0.5"/></Border.Effect>
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="ToastGlyph" Text="&#xE73E;" Style="{StaticResource Glyph}" Foreground="{StaticResource Success}" Margin="0,0,10,0"/>
                <TextBlock x:Name="ToastText" FontSize="13.5"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>

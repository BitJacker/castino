<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>Lindo</RootNamespace>
    <AssemblyName>Lindo</AssemblyName>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\lindo.ico</ApplicationIcon>
    <Version>1.1.1</Version>
    <FileVersion>1.1.1.0</FileVersion>
    <Product>Lindo</Product>
    <Company>Lindo</Company>
    <Description>Lindo - disinstalla le app senza lasciare residui</Description>
    <Copyright>© 2026 Lindo</Copyright>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>embedded</DebugType>
    <SatelliteResourceLanguages>it</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Lindo.Core\**\*.cs" Link="Core\%(RecursiveDir)%(Filename)%(Extension)" />
    <Resource Include="..\..\assets\lindo.ico" Link="Assets\lindo.ico" />
    <Resource Include="..\..\assets\logo.png" Link="Assets\logo.png" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>
</Project>

<?xml version="1.0" encoding="utf-8"?>
<!--
  Installer MSI di Lindo.
  Si compila con wixl (msitools) su Linux:   wixl -a x64 -D Version=1.0.0 -D BinDir=... -o Lindo.msi installer/Lindo.wxs
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" Name="Lindo" Language="1040" Codepage="1252" Version="$(var.Version)"
           Manufacturer="Lindo" UpgradeCode="6B1D7C3E-2F4A-4C8E-9A51-3D7E0B2F9C41">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine"
             Description="Lindo - disinstalla le app senza lasciare residui" Comments="Lindo" Manufacturer="Lindo" />

    <MajorUpgrade DowngradeErrorMessage="È già installata una versione più recente di Lindo." />
    <Media Id="1" Cabinet="lindo.cab" EmbedCab="yes" />

    <Icon Id="LindoIcon" SourceFile="$(var.AssetsDir)/lindo.ico" />
    <Property Id="ARPPRODUCTICON" Value="LindoIcon" />
    <Property Id="ARPHELPLINK" Value="https://github.com/bitjacker/castino" />
    <Property Id="ARPNOMODIFY" Value="1" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLDIR" Name="Lindo">
          <Component Id="MainExe" Guid="3F0A51D2-8B6C-4E1F-A7D3-5C2B9E8F1A60" Win64="yes">
            <File Id="LindoExe" Name="Lindo.exe" Source="$(var.BinDir)/Lindo.exe" KeyPath="yes" />
            <File Id="LindoConfig" Name="Lindo.exe.config" Source="$(var.BinDir)/Lindo.exe.config" />
            <File Id="LindoMonitorExe" Name="LindoMonitor.exe" Source="$(var.BinDir)/LindoMonitor.exe" />
          </Component>
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Component Id="StartShortcut" Guid="9C2E4B17-6D3A-4F85-B1E2-7A0C5D9E3F28" Win64="yes">
          <Shortcut Id="LindoStart" Name="Lindo" Description="Disinstalla le app senza lasciare residui"
                    Target="[INSTALLDIR]Lindo.exe" WorkingDirectory="INSTALLDIR" Icon="LindoIcon" />
          <RegistryValue Root="HKCU" Key="Software\Lindo" Name="StartShortcut" Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
      <Directory Id="DesktopFolder">
        <Component Id="DesktopShortcut" Guid="E4A7C2B9-1F6D-4B3E-8C5A-2D9F7E1B6A34" Win64="yes">
          <Shortcut Id="LindoDesktop" Name="Lindo" Description="Disinstalla le app senza lasciare residui"
                    Target="[INSTALLDIR]Lindo.exe" WorkingDirectory="INSTALLDIR" Icon="LindoIcon" />
          <RegistryValue Root="HKCU" Key="Software\Lindo" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </Directory>

    <Feature Id="Main" Title="Lindo" Level="1">
      <ComponentRef Id="MainExe" />
      <ComponentRef Id="StartShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>
  </Product>
</Wix>
